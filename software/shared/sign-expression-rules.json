{
  "schemaVersion": 1,
  "version": "expression-rules-3",
  "rules": [
    {
      "id": "greeting",
      "inputs": [
        "你好呀",
        "你好啊",
        "哈喽"
      ],
      "output": "你好",
      "note": "省去问候中的语气词。"
    },
    {
      "id": "thanks",
      "inputs": [
        "感谢",
        "谢谢啊",
        "谢谢呀",
        "多谢",
        "多谢了"
      ],
      "output": "谢谢",
      "note": "用已有的“谢谢”表达感谢。"
    },
    {
      "id": "thanks-you",
      "inputs": [
        "感谢你",
        "谢谢你呀",
        "谢谢你啊",
        "多谢你了",
        "谢谢你了"
      ],
      "output": "谢谢你",
      "note": "用“谢谢 → 你”表达对对方的感谢。"
    },
    {
      "id": "strong-thanks",
      "inputs": [
        "非常感谢",
        "真的很感谢",
        "真的非常感谢",
        "太感谢了"
      ],
      "output": "谢谢",
      "note": "感谢程度暂未单独表现，拟用“谢谢”表达，请核对是否满足原意。"
    },
    {
      "id": "strong-thanks-you",
      "inputs": [
        "非常感谢你",
        "真的很感谢你",
        "真的非常感谢你",
        "太感谢你了"
      ],
      "output": "谢谢你",
      "note": "保留感谢的对象；感谢程度暂未单独表现，请核对是否满足原意。"
    },
    {
      "id": "apology",
      "inputs": [
        "抱歉",
        "对不起啊"
      ],
      "output": "对不起",
      "note": "用已有的“对不起”表达道歉。"
    },
    {
      "id": "farewell",
      "inputs": [
        "拜拜",
        "再见啦"
      ],
      "output": "再见",
      "note": "用已有的“再见”表达告别。"
    },
    {
      "id": "hospital-register-request",
      "inputs": [
        "我想挂号",
        "我想要挂号",
        "我要挂号"
      ],
      "output": "我需要挂号",
      "note": "用已有的“需要”表达挂号需求，保留“我”。"
    },
    {
      "id": "hospital-check-request",
      "inputs": [
        "我想检查",
        "我想要检查",
        "我要检查"
      ],
      "output": "我需要检查",
      "note": "用已有动作表达检查需求。"
    },
    {
      "id": "help-request-polite",
      "inputs": [
        "请帮帮我",
        "请帮我一下",
        "请帮我"
      ],
      "output": "请帮助我",
      "note": "保留请求与帮助对象，用已有“帮助”表达“帮帮”。"
    },
    {
      "id": "help-request",
      "inputs": [
        "帮帮我",
        "帮我一下"
      ],
      "output": "帮助我",
      "note": "用已有动作表达帮助请求，保留帮助对象。"
    },
    {
      "id": "hospital-doctor-request",
      "inputs": [
        "我想看医生",
        "我要看医生",
        "我想找医生"
      ],
      "output": "我需要医生",
      "note": "用已有动作表达需要医生帮助的请求。"
    },
    {
      "id": "hospital-fever",
      "inputs": [
        "我发热",
        "我发烧了"
      ],
      "output": "我发烧",
      "note": "用已有“发烧”动作表达，保留“我”。"
    },
    {
      "id": "hospital-local-pain",
      "inputs": [
        "我这里疼",
        "我这里疼痛"
      ],
      "output": "我这里痛",
      "note": "保留“我”和位置指向，用已有“痛”表达。"
    },
    {
      "id": "hospital-no-allergy",
      "inputs": [
        "没过敏"
      ],
      "output": "没有过敏",
      "note": "保留否定含义。"
    },
    {
      "id": "hospital-my-no-allergy",
      "inputs": [
        "我没过敏"
      ],
      "output": "我没有过敏",
      "note": "保留“我”和否定含义，不扩展为过敏史判断。"
    },
    {
      "id": "hospital-where-挂号",
      "inputs": [
        "挂号在哪里",
        "挂号在哪儿",
        "挂号在哪"
      ],
      "output": "挂号哪里",
      "note": "位置询问由已有“哪里”动作表达。"
    },
    {
      "id": "hospital-where-门诊",
      "inputs": [
        "门诊在哪里",
        "门诊在哪儿",
        "门诊在哪"
      ],
      "output": "门诊哪里",
      "note": "位置询问由已有“哪里”动作表达。"
    },
    {
      "id": "hospital-where-医院",
      "inputs": [
        "医院在哪里",
        "医院在哪儿",
        "医院在哪"
      ],
      "output": "医院哪里",
      "note": "位置询问由已有“哪里”动作表达。"
    },
    {
      "id": "hospital-where-医生",
      "inputs": [
        "医生在哪里",
        "医生在哪儿",
        "医生在哪"
      ],
      "output": "医生哪里",
      "note": "位置询问由已有“哪里”动作表达。"
    },
    {
      "id": "hospital-where-报告",
      "inputs": [
        "报告在哪里",
        "报告在哪儿",
        "报告在哪"
      ],
      "output": "报告哪里",
      "note": "位置询问由已有“哪里”动作表达。"
    }
  ]
}
