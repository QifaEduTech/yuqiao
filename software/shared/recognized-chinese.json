{
  "version": "recognized-chinese-1",
  "maxWords": 60,
  "maxCharacters": 500,
  "subjects": ["我", "你"],
  "predicates": ["需要", "有", "没有", "是", "不是", "爱"],
  "verbs": ["帮助", "给", "检查", "挂号", "等候"],
  "symptoms": ["痛", "发烧", "过敏"],
  "places": ["医院", "门诊", "挂号", "医生", "报告", "药", "身份证"],
  "needObjects": ["帮助", "挂号", "检查", "医生", "药", "报告", "身份证", "志愿者"],
  "greetings": ["你好", "谢谢", "对不起", "再见", "好"],
  "reserved": ["我", "你", "需要", "有", "没有", "是", "不是", "爱", "请", "可以", "哪里", "什么", "这里", "你好", "谢谢", "对不起", "再见", "好", "不", "没", "别", "不要", "不能", "吗", "不需要", "不知道"],
  "rules": [
    {"id":"subject-predicate-object","pattern":["$subject","$predicate","$object"],"order":[0,1,2]},
    {"id":"predicate-object","pattern":["$predicate","$object"],"order":[0,1]},
    {"id":"subject-symptom","pattern":["$subject","$symptom"],"order":[0,1]},
    {"id":"local-pain","pattern":["这里","痛"],"order":[0,1]},
    {"id":"subject-local-pain","pattern":["$subject","这里","痛"],"order":[0,1,2]},
    {"id":"verb-person","pattern":["帮助","$subject"],"order":[0,1]},
    {"id":"subject-help-person","pattern":["$subject","帮助","$subject"],"order":[0,1,2]},
    {"id":"love-person","pattern":["爱","$subject"],"order":[0,1]},
    {"id":"subject-love-person","pattern":["$subject","爱","$subject"],"order":[0,1,2]},
    {"id":"give-object","pattern":["给","$object"],"order":[0,1]},
    {"id":"give-person-object","pattern":["给","$subject","$object"],"order":[0,1,2]},
    {"id":"subject-give-person-object","pattern":["$subject","给","$subject","$object"],"order":[0,1,2,3]},
    {"id":"please-verb","pattern":["请","$verb"],"order":[0,1]},
    {"id":"please-help-person","pattern":["请","帮助","$subject"],"order":[0,1,2]},
    {"id":"please-give-object","pattern":["请","给","$object"],"order":[0,1,2]},
    {"id":"please-give-person-object","pattern":["请","给","$subject","$object"],"order":[0,1,2,3]},
    {"id":"can-verb","pattern":["可以","$verb"],"order":[0,1]},
    {"id":"subject-can-verb","pattern":["$subject","可以","$verb"],"order":[0,1,2]},
    {"id":"thanks-person","pattern":["谢谢","$subject"],"order":[0,1]},
    {"id":"object-subject-need","pattern":["$needObject","$subject","需要"],"order":[1,2,0]},
    {"id":"subject-object-need","pattern":["$subject","$needObject","需要"],"order":[0,2,1]},
    {"id":"place-where","pattern":["$place","哪里"],"order":[0,"在",1],"question":true},
    {"id":"where-place","pattern":["哪里","$place"],"order":[1,"在",0],"question":true},
    {"id":"where-pain","pattern":["哪里","痛"],"order":[0,1],"question":true},
    {"id":"what-object","pattern":["什么","$object"],"order":[0,1],"question":true}
  ]
}
