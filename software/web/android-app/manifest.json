    "distribute": {
      "android": {
        "packagename": "cn.yuqiao.app",
        "minSdkVersion": 26,
        "targetSdkVersion": 34,
        "permissions": ["<uses-permission android:name=\"android.permission.INTERNET\"/>", "<uses-permission android:name=\"android.permission.CAMERA\"/>", "<uses-permission android:name=\"android.permission.RECORD_AUDIO\"/>"]
      }
    }
